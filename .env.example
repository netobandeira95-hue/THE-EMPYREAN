PORT=3000

# === CONFIGURAÇÃO DO DISCORD ===
# Token do Bot do Discord (obtido em https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=SEU_DISCORD_BOT_TOKEN

# ID do canal de texto no Discord onde as mídias serão enviadas
DISCORD_CHANNEL_ID=SEU_DISCORD_CHANNEL_ID

# === CONFIGURAÇÃO DO TELEGRAM ===
# Token do Bot do Telegram (obtido falando com @BotFather no Telegram)
TELEGRAM_BOT_TOKEN=SEU_TELEGRAM_BOT_TOKEN

# Opcional: ID do grupo do Telegram para filtrar (se vazio, recebe de todos os grupos onde o bot estiver)
TELEGRAM_TARGET_GROUP_ID=

# === CONFIGURAÇÃO DO WHATSAPP (OPCIONAL) ===
# Token secreto para autenticar requisições no endpoint POST /webhook/whatsapp
WEBHOOK_SECRET=chave_secreta_whatsapp

