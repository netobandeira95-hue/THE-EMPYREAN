#!/usr/bin/env bash
# ==============================================================================
# THE-EMPYREAN — Pre-Commit Hook Soberano (Zero-Leak & Isolamento por Bloco)
# ==============================================================================
# Regras aplicadas automaticamente antes de qualquer commit:
# 1. Bloqueia commits vazios.
# 2. Exclui e bloqueia qualquer arquivo listado nas regras do .gitignore:
#    (.env, data/processed, domain_databases, research_datasets, .csv, .xlsx,
#     storage, .sqlite, .db, .key, .pem, .crt, .p12, .cer, .vsix, ._*).
# 3. No repositório raiz, exige que o commit pertença a UM ÚNICO BLOCO
#    (NOME DA FERRAMENTA/ARQUIVO/PASTA) e valida o remote correspondente:
#    https://github.com/netobandeira95-hue/THE-EMPYREAN-(NOME).git
# 4. Executa auditoria profunda de PII, senhas, chaves, CRM, CPF, CNPJ, Team ID,
#    emails, GCP/CF project IDs, usernames e volumes locais, além de revisar e
#    registrar novos termos suspeitos em config/pii-blocklist.txt.
# ==============================================================================

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
EMPYREAN_ROOT="/Volumes/THEEMPYREAN"
BLOCKLIST_FILE="$EMPYREAN_ROOT/config/pii-blocklist.txt"
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'

# ── 1. Empty commit guard ──────────────────────────────────────────────────────
STAGED_FILES="$(git diff --cached --name-only)"
if [[ -z "$STAGED_FILES" ]]; then
  echo -e "${RED}❌ BLOQUEADO: Commit vazio — nenhum arquivo em stage.${NC}"
  exit 1
fi

# ── 2. Enforce .gitignore & Forbidden File Types / Directories ─────────────────
FORBIDDEN_FILE_REGEX='(^|/)\.env($|\.)|(^|/)data/(processed|raw|models)/|(^|/)(domain_databases|research_datasets|personal_vault|storage|qdrant_storage)/|\.(csv|xlsx|sqlite|sqlite3|db|mv\.db|key|pem|crt|p12|cer|pfx|vsix)$|(^|/)\._'

forbidden_staged=()
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  # Allow .env.example
  if [[ "$file" == *.env.example ]]; then
    continue
  fi
  if echo "$file" | grep -qE "$FORBIDDEN_FILE_REGEX"; then
    forbidden_staged+=("$file")
  fi
done <<< "$STAGED_FILES"

if [[ ${#forbidden_staged[@]} -gt 0 ]]; then
  echo -e "${RED}❌ BLOQUEADO: Arquivos proibidos pela política Zero-Leak / .gitignore detectados no stage:${NC}"
  for f in "${forbidden_staged[@]}"; do
    echo -e "  ${RED}•${NC} $f"
    git rm --cached -q "$f" 2>/dev/null || true
  done
  echo -e "${YELLOW}→ Os arquivos acima foram removidos do stage automaticamente.${NC}"
  exit 1
fi

# ── 3. Single-Block Enforcement (NOME DA FERRAMENTA/ARQUIVO/PASTA) ─────────────
if [[ "$REPO_ROOT" == "$EMPYREAN_ROOT" ]]; then
  blocks=()
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    top="$(echo "$file" | cut -d'/' -f1)"
    second="$(echo "$file" | cut -d'/' -f2)"
    case "$top" in
      apps|packages|services|templates)
        if [[ -n "$second" && "$second" != ".gitkeep" ]]; then
          blocks+=("$top/$second")
        else
          blocks+=("ROOT")
        fi
        ;;
      scripts)
        if [[ "$second" == "automacao-scripts" ]]; then
          blocks+=("scripts/automacao-scripts")
        elif [[ "$second" == ".gitkeep" ]]; then
          blocks+=("ROOT")
        else
          blocks+=("scripts")
        fi
        ;;
      infra|docs|config)
        if [[ "$second" == ".gitkeep" ]]; then
          blocks+=("ROOT")
        else
          blocks+=("$top")
        fi
        ;;
      *)
        blocks+=("ROOT")
        ;;
    esac
  done <<< "$STAGED_FILES"

  unique_blocks=()
  while IFS= read -r b; do
    [[ -n "$b" ]] && unique_blocks+=("$b")
  done < <(printf "%s\n" "${blocks[@]}" | sort -u)

  if [[ ${#unique_blocks[@]} -gt 1 ]]; then
    echo -e "${RED}❌ BLOQUEADO PELA REGRA DE BLOCOS:${NC}"
    echo "   Commits não podem misturar mais de um bloco (NOME DA FERRAMENTA/ARQUIVO/PASTA)."
    echo "   Blocos detectados neste stage (${#unique_blocks[@]}):"
    for ub in "${unique_blocks[@]}"; do
      echo -e "     ${RED}•${NC} $ub"
    done
    echo "   Faça commits separados em branches derivadas de main para cada bloco."
    exit 1
  fi
fi

# ── 4. Deep PII, Secrets & Local Paths Audit + Auto-Discovery ─────────────────
# Run Python auditor on staged files (excluding binary/deleted files)
python3 - "$REPO_ROOT" "$BLOCKLIST_FILE" << 'PYEOF'
import os
import re
import subprocess
import sys
from pathlib import Path

repo_root = Path(sys.argv[1])
blocklist_path = Path(sys.argv[2])

# Load dynamic blocklist
blocklist_terms = []
if blocklist_path.exists():
    for line in blocklist_path.read_text(encoding="utf-8", errors="ignore").splitlines():
        s = line.strip()
        if s and not s.startswith("#"):
            blocklist_terms.append(s)

# Auto-discover current environment username if non-generic and ensure it's monitored
cur_user = os.environ.get("USER") or os.environ.get("LOGNAME") or ""
if cur_user and cur_user not in ("root", "runner", "ubuntu", "git", "node", "python"):
    user_path = f"/Users/{cur_user}"
    if user_path not in blocklist_terms:
        blocklist_terms.append(user_path)

res = subprocess.run(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
    cwd=str(repo_root),
    capture_output=True,
    text=True,
)
staged_files = [f.strip() for f in res.stdout.splitlines() if f.strip()]

THIRD_PARTY_PREFIXES = (
    "services/nexus-portal/",
    "packages/CLI-Anything/",
    "packages/cc-switch/",
    "packages/context-mode/",
    "packages/rea/",
    "templates/frappe-bench/",
)
# If running inside a 3rd-party subrepo itself:
is_third_party_repo = repo_root.name in {
    "nexus-portal", "CLI-Anything", "cc-switch", "context-mode", "rea", "frappe-bench"
}

REGEX_CHECKS = [
    ("CPF detectado", re.compile(r"\b\d{3}\.\d{3}\.\d{3}-\d{2}\b")),
    ("CNPJ detectado", re.compile(r"\b\d{2}\.\d{3}\.\d{3}/\d{4}-\d{2}\b")),
    ("CRM médico detectado", re.compile(r"\bCRM[\s/-]*(AL|SP|RJ|MG|BA|PE|RS|PR|SC)[\s/-]*\d{3,6}\b", re.I)),
    ("Telefone BR detectado", re.compile(r"(\+55\s*\(?\d{2}\)?\s*\d{4,5}[-\s]?\d{4}|\(82\)\s*9?\d{4}[-\s]?\d{4})")),
    ("API Key / Token detectado", re.compile(r"(AIzaSy[0-9A-Za-z_-]{20,}|AQ\.Ab8R[0-9A-Za-z_.-]+|sk-[a-zA-Z0-9]{32,}|ghp_[a-zA-Z0-9]{30,}|glpat-[a-zA-Z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ox_[a-zA-Z0-9_-]{20,})")),
    ("Bloco de Chave Privada detectado", re.compile(r"BEGIN [A-Z ]*PRIVATE KEY")),
    ("Caminho local de usuário (/Users/...) detectado", re.compile(r"(?<![A-Za-z0-9_/-])/Users/(?!YOUR_USERNAME\b|runner\b|shared\b|nobody\b)[a-z][a-z0-9._-]{2,}\b")),
    ("Volume legado (/Volumes/IA-INFRA ou ~/ai-infra) detectado", re.compile(r"(/Volumes/IA-INFRA|~/ai-infra\b)")),
    ("Atribuição de segredo/senha hardcoded detectada", re.compile(r"(GMAIL_APP_PASSWORD|SQ_API_KEY|POSTGRES_PASSWORD|N8N_BASIC_AUTH_PASSWORD|N8N_ENCRYPTION_KEY|LISTMONK_app__admin_password|SECRET_KEY_BASE)\s*[:=]\s*['\"]?(?![$\s\"']|CHANGE_ME|YOUR_)[A-Za-z0-9_/-]{12,}")),
]

issues = []
newly_discovered_terms = set()

EXEMPT_FILES = {
    "config/pii-blocklist.txt",
    "pii-blocklist.txt",
    "scripts/hooks/pre-commit",
    "hooks/pre-commit",
    "scripts/sync_empyrean_blocks.py",
    "sync_empyrean_blocks.py",
    "packages/sanityzer/sanityzer/regulations.py",
    "packages/sanityzer/sanityzer/engine.py",
    "packages/sanityzer/README.md",
    "sanityzer/regulations.py",
    "sanityzer/engine.py",
}

for rel_path in staged_files:
    if rel_path in EXEMPT_FILES or (repo_root.name == "sanityzer" and rel_path == "README.md"):
        continue
    full_path = repo_root / rel_path
    if not full_path.is_file() or full_path.is_symlink():
        continue
    if full_path.stat().st_size > 2 * 1024 * 1024:
        continue

    in_tp = is_third_party_repo or rel_path.startswith(THIRD_PARTY_PREFIXES)
    if in_tp and full_path.name not in {"ia-infra-unified-mcp.mjs", "ia-infra-mcp-gateway.mjs"} and "rea-extension" not in rel_path:
        # For upstream 3rd-party files, still check our explicit personal blocklist terms
        try:
            content = full_path.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            continue
        for term in blocklist_terms:
            if term in content:
                issues.append(f"{rel_path}: termo bloqueado '{term}'")
        continue

    try:
        content = full_path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        continue

    for term in blocklist_terms:
        if term in content:
            issues.append(f"{rel_path}: termo bloqueado '{term}'")

    for lineno, line in enumerate(content.splitlines(), 1):
        if len(line) > 600:
            continue
        for label, pat in REGEX_CHECKS:
            m = pat.search(line)
            if m:
                matched_val = m.group(0)
                issues.append(f"{rel_path}:{lineno}: {label} ({matched_val[:40]})")
                if label in ("API Key / Token detectado", "Caminho local de usuário (/Users/...) detectado"):
                    if matched_val not in blocklist_terms:
                        newly_discovered_terms.add(matched_val)

if newly_discovered_terms and blocklist_path.exists():
    with blocklist_path.open("a", encoding="utf-8") as bf:
        for t in sorted(newly_discovered_terms):
            bf.write(f"{t}\n")

if issues:
    print("\033[0;31m❌ BLOQUEADO PELA AUDITORIA ZERO-LEAK (PII / Segredos / Caminhos Locais):\033[0m")
    for iss in issues[:25]:
        print(f"  \033[0;31m•\033[0m {iss}")
    if len(issues) > 25:
        print(f"  ... e mais {len(issues) - 25} ocorrência(s).")
    if newly_discovered_terms:
        print(f"\033[1;33m→ {len(newly_discovered_terms)} novo(s) termo(s) suspeito(s) adicionado(s) automaticamente em config/pii-blocklist.txt.\033[0m")
    sys.exit(1)
PYEOF

echo -e "${GREEN}✓ Auditoria Zero-Leak e Regra de Bloco aprovadas ($(echo "$STAGED_FILES" | wc -l | tr -d ' ') arquivo(s))${NC}"
